# Copie para .env (local) ou cadastre no Render (Environment). Nunca suba o .env.

# Porta (o Render define sozinho em produção)
PORT=3000

# Mesmo valor de VITE_APP_SECRET no .env do app Balcão.
# Só identifica as chamadas do app; não é a autenticação com a Google.
APP_SECRET=defina_um_segredo_aleatorio_forte

# Assina (HMAC-SHA256) o estado Premium devolvido ao app. Fica só aqui.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PREMIUM_SIGNING_SECRET=defina_outro_segredo_aleatorio_forte

# applicationId do app Android
ANDROID_PACKAGE_NAME=com.balcao.app

# Conteúdo do .json da conta de serviço do Google Cloud, em UMA linha.
# Pode ser a mesma conta já usada nos outros apps; no Play Console, dê a ela
# acesso ao Balcão (Usuários e permissões > ver dados financeiros e
# gerenciar pedidos e assinaturas).
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}
